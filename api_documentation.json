{
  "openapi": "3.0.0",
  "info": {
    "title": "E-commerce Backend API",
    "version": "1.0.0",
    "description": "API REST pour le frontend e-commerce"
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Serveur de développement"
    }
  ],
  "paths": {
    "/categories/": {
      "get": {
        "summary": "Liste des catégories",
        "tags": ["Categories"],
        "responses": {
          "200": {
            "description": "Liste des catégories actives",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Category"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/categories/{slug}/": {
      "get": {
        "summary": "Détail d'une catégorie",
        "tags": ["Categories"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Détails de la catégorie",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Category"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Catégorie non trouvée"
          }
        }
      }
    },
    "/products/": {
      "get": {
        "summary": "Liste des produits",
        "tags": ["Products"],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Filtrer par slug de catégorie",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Recherche dans nom et description",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "description": "Prix minimum",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "description": "Prix maximum",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Numéro de page",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Nombre d'items par page (max 100)",
            "schema": {
              "type": "integer",
              "default": 12
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste paginée des produits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "next": {
                          "type": "string",
                          "nullable": true
                        },
                        "previous": {
                          "type": "string",
                          "nullable": true
                        },
                        "results": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ProductList"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products/{slug}/": {
      "get": {
        "summary": "Détail d'un produit",
        "tags": ["Products"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Détails du produit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ProductDetail"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Produit non trouvé"
          }
        }
      }
    },
    "/auth/signup/": {
      "post": {
        "summary": "Inscription d'un nouvel utilisateur",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password", "password_confirm"],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  },
                  "password_confirm": {
                    "type": "string"
                  },
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Utilisateur créé avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "$ref": "#/components/schemas/User"
                        },
                        "tokens": {
                          "$ref": "#/components/schemas/JWTTokens"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erreur de validation"
          }
        }
      }
    },
    "/auth/login/": {
      "post": {
        "summary": "Connexion d'un utilisateur",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connexion réussie",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "$ref": "#/components/schemas/User"
                        },
                        "tokens": {
                          "$ref": "#/components/schemas/JWTTokens"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Identifiants incorrects"
          }
        }
      }
    },
    "/auth/logout/": {
      "post": {
        "summary": "Déconnexion (blacklist du refresh token)",
        "tags": ["Authentication"],
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refresh": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Déconnexion réussie"
          },
          "400": {
            "description": "Erreur lors de la déconnexion"
          }
        }
      }
    },
    "/auth/profile/": {
      "get": {
        "summary": "Récupérer le profil utilisateur",
        "tags": ["Authentication"],
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {
            "description": "Profil utilisateur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Non authentifié"
          }
        }
      },
      "put": {
        "summary": "Mettre à jour le profil utilisateur (complet)",
        "tags": ["Authentication"],
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profil mis à jour"
          },
          "400": {
            "description": "Erreur de validation"
          }
        }
      },
      "patch": {
        "summary": "Mettre à jour le profil utilisateur (partiel)",
        "tags": ["Authentication"],
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profil mis à jour"
          },
          "400": {
            "description": "Erreur de validation"
          }
        }
      }
    },
    "/auth/refresh/": {
      "post": {
        "summary": "Rafraîchir le token d'accès",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refresh"],
                "properties": {
                  "refresh": {
                    "type": "string",
                    "description": "Refresh token"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nouveau token d'accès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token invalide ou expiré"
          }
        }
      }
    },
    "/cart/": {
      "get": {
        "summary": "Récupérer le panier",
        "tags": ["Cart"],
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {
            "description": "Panier de l'utilisateur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Cart"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cart/add/": {
      "post": {
        "summary": "Ajouter un produit au panier",
        "tags": ["Cart"],
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["product_id"],
                "properties": {
                  "product_id": {
                    "type": "integer"
                  },
                  "quantity": {
                    "type": "integer",
                    "default": 1,
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produit ajouté au panier",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Cart"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erreur (stock insuffisant, produit inexistant)"
          }
        }
      }
    },
    "/cart/update/{item_id}/": {
      "patch": {
        "summary": "Modifier la quantité d'un item",
        "tags": ["Cart"],
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["quantity"],
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quantité mise à jour"
          },
          "400": {
            "description": "Stock insuffisant"
          },
          "404": {
            "description": "Item non trouvé"
          }
        }
      }
    },
    "/cart/remove/{item_id}/": {
      "delete": {
        "summary": "Retirer un produit du panier",
        "tags": ["Cart"],
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produit retiré du panier"
          },
          "404": {
            "description": "Item non trouvé"
          }
        }
      }
    },
    "/cart/clear/": {
      "delete": {
        "summary": "Vider le panier",
        "tags": ["Cart"],
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {
            "description": "Panier vidé"
          }
        }
      }
    },
    "/orders/create/": {
      "post": {
        "summary": "Créer une commande depuis le panier",
        "tags": ["Orders"],
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["shipping_address", "shipping_city", "shipping_postal_code", "shipping_phone"],
                "properties": {
                  "shipping_address": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "shipping_city": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "shipping_postal_code": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "shipping_phone": {
                    "type": "string",
                    "maxLength": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Commande créée avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/OrderDetail"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erreur (panier vide, stock insuffisant)"
          }
        }
      }
    },
    "/orders/": {
      "get": {
        "summary": "Liste des commandes de l'utilisateur",
        "tags": ["Orders"],
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {
            "description": "Liste des commandes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OrderList"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}/": {
      "get": {
        "summary": "Détail d'une commande",
        "tags": ["Orders"],
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Détail de la commande",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/OrderDetail"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Commande non trouvée"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "is_active": {
            "type": "boolean"
          },
          "products_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProductList": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "stock": {
            "type": "integer"
          },
          "category": {
            "type": "integer"
          },
          "category_name": {
            "type": "string"
          },
          "main_image": {
            "type": "string",
            "nullable": true
          },
          "is_active": {
            "type": "boolean"
          },
          "in_stock": {
            "type": "boolean"
          }
        }
      },
      "ProductDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "stock": {
            "type": "integer"
          },
          "category": {
            "type": "integer"
          },
          "category_name": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductImage"
            }
          },
          "is_active": {
            "type": "boolean"
          },
          "in_stock": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProductImage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "image": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "date_joined": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          }
        }
      },
      "JWTTokens": {
        "type": "object",
        "properties": {
          "refresh": {
            "type": "string",
            "description": "Refresh token (validité: 7 jours)"
          },
          "access": {
            "type": "string",
            "description": "Access token (validité: 60 minutes)"
          }
        }
      },
      "Cart": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "user": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "total": {
            "type": "string",
            "description": "Prix total du panier"
          },
          "items_count": {
            "type": "integer",
            "description": "Nombre total d'articles"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "product": {
            "type": "integer"
          },
          "product_name": {
            "type": "string"
          },
          "product_image": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          },
          "quantity": {
            "type": "integer"
          },
          "price_unit": {
            "type": "string",
            "description": "Prix unitaire au moment de l'ajout"
          },
          "subtotal": {
            "type": "string",
            "description": "Sous-total (quantity × price_unit)"
          }
        }
      },
      "OrderList": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "paid", "shipped", "delivered", "cancelled"]
          },
          "total": {
            "type": "string"
          },
          "items_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "user": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "paid", "shipped", "delivered", "cancelled"]
          },
          "total": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
